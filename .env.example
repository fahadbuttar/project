# Server Port
PORT=3001

# MongoDB Connection String (without trailing slash, e.g. mongodb://localhost:27017)
MONGO_DB_URI=mongodb://localhost:27017

# JWT Secrets and Expirations
ACCESS_TOKEN_SECRET=volt_super_secret_access_token_key_2026
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=volt_super_secret_refresh_token_key_2026
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary Credentials (Required for avatar photo uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OpenAI API Key (Required for AI voice query transcription & intent parsing)
OPENAI_API_KEY=your_openai_api_key

# Frontend Client Origin for CORS
CORS_ORIGIN=http://localhost:5173

# Super Admin Seed Credentials (for npm run createAdmin / tsx src/createAdmin.ts)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@voltmanage.com
ADMIN_PASSWORD=adminpassword123
